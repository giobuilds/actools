<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AcManager.App.ViewModels"
             x:Class="AcManager.App.Views.AboutView"
             x:DataType="vm:AboutViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="10">
      <TextBlock Text="Content Manager for Linux" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" />
      <TextBlock Text="{Binding UpdateNote}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ReleasesPage}" Opacity="0.8" />
      <Button Content="Check for updates" Command="{Binding CheckCommand}" HorizontalAlignment="Left" />

      <TextBlock Text="License" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
      <TextBox IsReadOnly="True" Text="{Binding LicenseText, Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="True" />

      <TextBlock Text="Third-party notices" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
      <TextBox IsReadOnly="True" Text="{Binding NoticeText, Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="True" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
