<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AcManager.App.ViewModels"
             x:Class="AcManager.App.Views.ResultsView"
             x:DataType="vm:ResultsViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="10">
      <TextBlock Text="Results" FontSize="28" FontWeight="SemiBold" />
      <TextBlock TextWrapping="Wrap" Opacity="0.8"
                 Text="The last session is read from out/race_out.json. Replays are the .acreplay files in the Documents replay folder." />

      <Button Content="Reload" Command="{Binding ReloadCommand}" HorizontalAlignment="Left" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />

      <TextBlock Text="Last session" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
      <ItemsControl ItemsSource="{Binding Lines}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Replays" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
      <ItemsControl ItemsSource="{Binding Replays}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
