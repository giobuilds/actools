<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AcManager.App.ViewModels"
        xmlns:views="using:AcManager.App.Views"
        x:Class="AcManager.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Content Manager"
        Width="1100"
        Height="720"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:InstallViewModel">
      <views:InstallView />
    </DataTemplate>
    <DataTemplate DataType="vm:DriveViewModel">
      <views:DriveView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="200,*">
    <Border Grid.Column="0" Padding="16" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4">
          <TextBlock Text="Content Manager" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="Assetto Corsa" Opacity="0.7" Margin="0,0,0,16" />
          <Button Content="Install" Command="{Binding ShowInstallCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
          <Button Content="Drive" Command="{Binding ShowDriveCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        </StackPanel>
        <TextBlock VerticalAlignment="Bottom" Opacity="0.6" TextWrapping="Wrap" Text="Practice sessions launch through Steam Proton." />
      </DockPanel>
    </Border>

    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="24" />
  </Grid>
</Window>
