<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AcManager.App.ViewModels"
             xmlns:content="using:AcManager.Core.Content"
             x:Class="AcManager.App.Views.ContentView"
             x:DataType="vm:ContentViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="12">
      <TextBlock Text="Content" FontSize="28" FontWeight="SemiBold" />
      <TextBlock TextWrapping="Wrap" Opacity="0.8"
                 Text="Install a car or a track from a .zip into the game content folder. The archive needs a ui/ui_car.json or ui/ui_track.json. A folder that is already there is left alone. 7z is not supported yet. Added cars and tracks can be removed below. Original game content stays installed." />

      <TextBlock Text="Archive" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0" Text="{Binding ArchivePath}" PlaceholderText="Path to a .zip archive" />
        <Button Grid.Column="1" Content="Browse…" Click="Browse" />
      </Grid>

      <Button Content="Install" Command="{Binding InstallCommand}" HorizontalAlignment="Left" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />

      <TextBlock Text="Added cars" />
      <TextBlock Text="{Binding RemovalNote}" TextWrapping="Wrap" Opacity="0.8" />
      <TextBlock Text="No added cars." IsVisible="{Binding ShowNoCars}" Opacity="0.7" />
      <ListBox ItemsSource="{Binding Cars}" SelectedItem="{Binding SelectedCar}" MaxHeight="160"
               IsVisible="{Binding !ShowNoCars}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="content:RemovablePiece">
            <StackPanel Margin="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Subtitle}" Opacity="0.65" FontSize="12" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Button Content="{Binding RemoveCarText}" Command="{Binding RemoveCarCommand}" HorizontalAlignment="Left" />

      <TextBlock Text="Added tracks" />
      <TextBlock Text="No added tracks." IsVisible="{Binding ShowNoTracks}" Opacity="0.7" />
      <ListBox ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" MaxHeight="160"
               IsVisible="{Binding !ShowNoTracks}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="content:RemovablePiece">
            <StackPanel Margin="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Subtitle}" Opacity="0.65" FontSize="12" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Button Content="{Binding RemoveTrackText}" Command="{Binding RemoveTrackCommand}" HorizontalAlignment="Left" />

      <TextBlock Text="Repairs" />
      <TextBlock Text="{Binding RepairNote}" TextWrapping="Wrap" Opacity="0.8" />
      <Button Content="Check for repairs" Command="{Binding CheckRepairsCommand}" HorizontalAlignment="Left" />
      <ListBox ItemsSource="{Binding Repairs}" SelectedItem="{Binding SelectedRepair}" MaxHeight="180"
               IsVisible="{Binding ShowRepairList}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="content:ContentRepair">
            <StackPanel Margin="2">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Detail}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Button Content="Apply repair" Command="{Binding ApplyRepairCommand}" HorizontalAlignment="Left" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
