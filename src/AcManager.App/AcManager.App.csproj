<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AcManager.App</RootNamespace>
    <AssemblyName>ContentManager</AssemblyName>
    <Version>1.4.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AcManager.Core/AcManager.Core.csproj" />
    <ProjectReference Include="../AcTools.Core/AcTools.Core.csproj" />
    <ProjectReference Include="../AcTools.Platform.Abstractions/AcTools.Platform.Abstractions.csproj" />
    <ProjectReference Include="../AcTools.Platform.Linux/AcTools.Platform.Linux.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!--
    The helper is a Windows exe. Drive copies it into the Proton prefix when it sits beside Content Manager.
    PublishAcBridge=false skips the copy, which keeps a design-time build from producing it.
  -->
  <PropertyGroup>
    <AcBridgeProject>$(MSBuildThisFileDirectory)../AcBridge/AcBridge.csproj</AcBridgeProject>
    <AcBridgePublishDir>$(MSBuildThisFileDirectory)obj/acbridge-publish/</AcBridgePublishDir>
  </PropertyGroup>
  <Target Name="PublishAcBridge" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and '$(PublishAcBridge)' != 'false'">
    <MSBuild
      Projects="$(AcBridgeProject)"
      Targets="Publish"
      Properties="Configuration=Release;RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;DebugType=none;DebugSymbols=false;PublishDir=$(AcBridgePublishDir)" />
    <Copy
      SourceFiles="$(AcBridgePublishDir)AcBridge.exe"
      DestinationFolder="$(TargetDir)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
